{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "exclude": ["src/data/sqlDb.ts", "src/data/sharedManuals.ts", "src/data/migrateSharedManuals.ts"],
  "include": [
    "src/**/*"
  ]
}
